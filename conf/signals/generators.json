 "files": {
  "approach_aware.chunk.awr_weights": {
   "sha256": "0def8a0808dec5c7ad2b7dabc29a1201686d23aae85fcc963cb0a00daa12692e",
   "generator": "awr@248275e",
   "product": "awr_weights.json",
   "argv": [
    "--reward",
    "phase",
    "--binding",
    "names",
    "--phase-balanced",
    "--names-map",
    "{names_map}",
    "--names-sha256",
    "{names_sha256}",
    "--index",
    "{roots_v2}",
    "--out",
    "{out}"
   ],
   "numerics": "tanh-f32-fma",
   "note": "binds through the shipped names table (inputs.episode_names). contact = 1 - tanh(K*d) runs on float32, and numpy's float32 tanh is its own SIMD kernel where the CPU has FMA (how this file was written) and the C library's tanhf where it does not: the two round 44.6% of the 1,906,469 inputs 1-3 ulp apart, which moves 16.7% of the weights by 1-6 ulp. The generator runs under the tanh-f32-fma numerics, numpy's kernel computed exactly in float64 (axis.signals.numerics.tanh_f32), which writes the locked bytes on either kind of CPU"
  },
