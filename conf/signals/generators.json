{
 "schema": "qvla.signals_generators/1",
 "about": "Which generator version, flags and inputs wrote each SIGNALS.lock file. SIGNALS.lock.json does not carry this map: it is vendored byte-for-byte into the LeRobot line, so its generator fields are as originally written and this file carries the map. A generator's `commit` is the commit that wrote that version or, for a module ported into the release, the port commit, with `ported_from` naming the original module. `digest_sources` are the files whose concatenated sha256 the generator stamps into its output (meta.generator_sha256). Module names and paths are those of the tree the files were built in: its import root `axis` is `axis_qvla` in the public repository. Every recorded source, every pinned module (`pins`: modules a generator executes that no output stamps), the names table and every built file is recorded by its sha256.",
 "lock_sha256": "6a7fdcda80a669ead5ff66689a729cc0875b991645d2242f8ae30f6f09ffeba1",
 "inputs": {
  "corpus": {
   "corpus_fingerprint": "sha256:44e1e35fe778070beac9a2618b44219a",
   "reads": "task_*/meta/{episodes,tasks.parquet}; the AWR builders and index.ranges also read task_*/data",
   "body_names": "approach_aware.chunk.awr_weights binds the object through per-episode meta/episodes body_names/object_body, which the corpus fingerprint does not cover, so it binds through the shipped episode_names table (inputs.episode_names), and the builder refuses names that do not digest to its pin"
  },
  "episode_names": {
   "file": "conf/signals/episode_body_names.json",
   "reward_input_sha256": "106f4cf84397772ad06e5a2ee2531f685d4ea27ff4f02848b8f894cefc81330a",
   "episodes": 5000,
   "about": "per-episode body_names (pose-column order) and object_body read from each episode's own recording trace; the digest is over the (key, body_names, object_body) triples in corpus order, so a corpus whose meta carries the same names digests to the same value (axis.dataset.episode_names)"
  },
  "roots_v2": {
   "sha256": "b0064197d005a2bdb00eadb36d5f701e61195f2694194514926bc7e98144c843",
   "file": "roots_libero_5k_v2.json",
   "derive": "the d8 roots index (index.roots_d8) with base ../corpus and without derived_from, action_space",
   "written_by": "axis.dataset.build_roots_index --src-root corpus --out artifacts/roots_libero_5k_v2.json"
  }
 },
